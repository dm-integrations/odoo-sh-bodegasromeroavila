<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--FORM-->
    <record id="dmi_product_component_form" model="ir.ui.view">
        <field name="model">dmi.product.component</field>
        <field name="name">dmi.product.component.form</field>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <form>
                <header>

                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="price_unit"/>
                            <field name="price_weight"/>
                        </group>
                        <group>
                            <field name="exclude_not_packaging"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!--TREE-->
    <record id="dmi_product_component_tree" model="ir.ui.view">
        <field name="model">dmi.product.component</field>
        <field name="name">dmi.product.component.tree</field>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="price_unit"/>
                <field name="price_weight"/>
                <field name="exclude_not_packaging"/>
            </tree>
        </field>
    </record>

    <!--  ACTION  -->
    <record id="action_dmi_product_component" model="ir.actions.act_window">
        <field name="name">Componentes Ecoembres</field>
        <field name="res_model">dmi.product.component</field>
    </record>

    <!--  MENU  -->
    <menuitem id="menu_dmi_product_component" name="Componentes Ecoembes" parent="stock.menu_product_in_config_stock"
            action="dmi_bodegasromero_scrap_invoice.action_dmi_product_component" sequence="5"/>

</odoo>