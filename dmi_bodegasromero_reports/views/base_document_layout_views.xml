<?xml version="1.0" ?>
<odoo>
    <record id="view_base_document_layout" model="ir.ui.view">
        <field name="model">base.document.layout</field>
        <field name="inherit_id" ref="web.view_base_document_layout" />
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='report_footer']" position='before'>
                <field name="dmi_report_terms_and_conditions" options="{'resizable': false}"/>
            </xpath>

        </field>
    </record>
</odoo>
