<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="account_report_inherit" inherit_id="account.report_invoice_document">
        <xpath expr="//t[@t-set='lines']" position="replace">
            <t t-set="lines"
                    t-value="o.invoice_line_ids.filtered(lambda k:k.discount != 100).sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>
            <t t-set="lines_muestra"
                    t-value="o.invoice_line_ids.filtered(lambda k:k.discount == 100).sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>
        </xpath>
        <xpath expr="//t[@t-foreach='lines']" position="after">
            <t t-if="lines_muestra">
                <tr>
                    <td style="background:#ddd;" colspan="99">
                        <strong t-options="{'widget': 'text'}">Muestras de productos</strong>
                    </td>
                </tr>
            </t>
            <t t-foreach="lines_muestra" t-as="line">
                <td name="account_invoice_line_name">
                    <span t-if="line.name" t-field="line.name" t-options="{'widget': 'text'}">Bacon Burger</span>
                </td>
                <td name="td_quantity" class="text-end">
                    <span t-field="line.quantity">3.00</span>
                    <span t-field="line.product_uom_id" groups="uom.group_uom">units</span>
                </td>
                <td name="td_price_unit"
                        t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                    <span class="text-nowrap" t-field="line.price_unit">9.00</span>
                </td>
                <td name="td_discount" t-if="display_discount"
                        t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                    <span class="text-nowrap" t-field="line.discount">0</span>
                </td>
                <t t-set="taxes" t-value="', '.join([(tax.invoice_label or tax.name) for tax in line.tax_ids])"/>
                <td name="td_taxes"
                        t-attf-class="text-start {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }} {{ 'text-nowrap' if len(taxes) &lt; 10 else '' }}">
                    <span t-out="taxes" id="line_tax_ids">Tax 15%</span>
                </td>
                <td name="td_subtotal" class="text-end o_price_total">
                    <span class="text-nowrap" t-field="line.price_subtotal">27.00</span>
                </td>
            </t>
        </xpath>

    </template>
</odoo>