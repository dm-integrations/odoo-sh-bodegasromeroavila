<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data noupdate="0">

        <record id="ir_cron_create_activiy_task_fecha_limite" model="ir.cron">
            <field name="name">Tareas: Avisar de tareas que se paso la fecha limite</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=1, minute=20) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="doall" eval="False"/>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="code">model.create_activity_date_limit()</field>
            <field name="state">code</field>
        </record>

    </data>
</odoo>
