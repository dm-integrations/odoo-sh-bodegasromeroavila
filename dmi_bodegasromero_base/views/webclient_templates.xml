<?xml version="1.0" ?>
<odoo>

    <template id="login_layout" inherit_id="web.login_layout">
        <xpath expr="//div[@class='text-center small mt-4 pt-3 border-top']/a[contains(@href, 'odoo.com')]"
                position="replace"/>
    </template>

    <template id="frontend_layout" inherit_id="web.frontend_layout">
        <xpath expr="//t[@t-call='web.brand_promotion']/parent::div"
                position="attributes">
            <attribute name="style">opacity: 0;</attribute>
        </xpath>
    </template>

</odoo>