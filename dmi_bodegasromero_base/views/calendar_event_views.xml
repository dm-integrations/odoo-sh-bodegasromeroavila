<?xml version="1.0" ?>
<odoo>

    <!--  VISTAS SEARCH  -->

    <record id="view_calendar_event_search" model="ir.ui.view">
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_ids']" position="after">
                <field name="project_id"/>
                <field name="task_id"/>
            </xpath>
            <xpath expr="//filter[@name='responsible']" position="before">
                <filter string="Proyecto" name="project" domain="[]" context="{'group_by': 'project_id'}"/>
            </xpath>
        </field>
    </record>

    <!--  VISTAS FORM  -->

    <record id="view_calendar_event_form" model="ir.ui.view">
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="task_id" invisible="1"/>
                <button name="action_view_task" type="object" class="oe_stat_button" icon="fa-pencil-square-o"
                        invisible="not task_id" string="Tarea"></button>
            </xpath>
        </field>
    </record>
</odoo>
