<?xml version="1.0" ?>
<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="priority">9</field>
        <field name="arch" type="xml">
            <xpath expr="//tree//field[@name='product_id']" position="before">
                <field name="product_image" widget="image" class="oe_avatar" readonly="1"/>
                <field name="reward_id" column_invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree" position="attributes">
                <attribute name="decoration-success">reward_id != False</attribute>
            </xpath>
        </field>
    </record>

    <record id="sale_order_view_search_inherit_quotation" model="ir.ui.view">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_view_search_inherit_quotation"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='my_quotation']" position="replace">
                <filter string="Mis presupuestos" name="my_quotation"
                        domain="['|', ('user_id', '=', uid),('partner_id.user_ids', 'in', [uid])]"/>
            </xpath>
        </field>
    </record>

</odoo>
