<odoo>
    <data>
        <!-- Heredamos y sustituimos las reglas de pedidos propios -->

        <record id="calendar_event_rule_employee_only_docs" model="ir.rule">
            <field name="name">Calendario: Acceso a documentos asignados</field>
            <field ref="calendar.model_calendar_event" name="model_id"/>
            <field name="domain_force">['|', ('user_id', '=', user.id), ('partner_ids', 'in', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('dmi_contact_access.group_commercial_own_user'))]"/>
        </record>

        <record id="calendar_event_rule_employee" model="ir.rule">
            <field name="name">Calendario: Acceso a todos los eventos</field>
            <field ref="calendar.model_calendar_event" name="model_id"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('dmi_contact_access.group_commercial_all_user'))]"/>
        </record>

    </data>
</odoo>
