<odoo>
    <data>
<!--    HEREDAMOS Y SUSTITUIMOS LAS REGLAS DE PEDIDOS PROPIOS    -->
        <record id="sale_order_personal_rule" model="ir.rule">
            <field name="name">Personal Orders</field>
            <field ref="sale.model_sale_order" name="model_id"/>
            <field name="domain_force">['|',('user_id','=',user.id),('partner_id.commercial_partner_id.user_ids','in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        </record>


        <record id="sale_order_line_personal_rule" model="ir.rule">
            <field name="name">Personal Order Lines</field>
            <field ref="sale.model_sale_order_line" name="model_id"/>
            <field name="domain_force">['|',('salesman_id','=',user.id),('order_partner_id.commercial_partner_id.user_ids','in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        </record>

    </data>
</odoo>