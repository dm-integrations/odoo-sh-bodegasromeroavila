<odoo>
    <data>
<!--    HEREDAMOS Y SUSTITUIMOS LAS REGLAS DE TARIFAS    -->

        <record id="ir_rule_pricelist_user" model="ir.rule">
            <field name="name">Permisos público tarifas</field>
            <field name="model_id" ref="product.model_product_pricelist" />
            <field name="groups" eval="[(4, ref('base.group_user'))]" />
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="False" />
            <field name="perm_create" eval="False" />
            <field name="perm_unlink" eval="False" />
        </record>

        <record id="ir_rule_pricelist_admin" model="ir.rule">
            <field name="name">Permisos administrador tarifas</field>
            <field name="model_id" ref="product.model_product_pricelist" />
            <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]" />
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="True" />
            <field name="perm_create" eval="True" />
            <field name="perm_unlink" eval="True" />
        </record>

        <record id="ir_rule_pricelist_item_user" model="ir.rule">
            <field name="name">Permisos público precios tarifas</field>
            <field name="model_id" ref="product.model_product_pricelist_item" />
            <field name="groups" eval="[(4, ref('base.group_user'))]" />
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="False" />
            <field name="perm_create" eval="False" />
            <field name="perm_unlink" eval="False" />
        </record>

        <record id="ir_rule_pricelist_item_admin" model="ir.rule">
            <field name="name">Permisos administrador precios tarifas</field>
            <field name="model_id" ref="product.model_product_pricelist_item" />
            <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]" />
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="True" />
            <field name="perm_create" eval="True" />
            <field name="perm_unlink" eval="True" />
        </record>

    </data>
</odoo>